# root-level npm deps (used only for the `concurrently` dev:frontend/dev:backend scripts)
/node_modules

# stray Next.js build cache that can land here if Turbopack mis-infers the workspace root
# (the real one is frontend/.next, which frontend/.gitignore already excludes)
/.next

# OS/editor junk
.DS_Store
Thumbs.db

# .NET build output (publish/ also carries a live appsettings.json copy with real DB credentials —
# never commit it)
/backend/bin/
/backend/obj/
/backend/publish/

# holds the real production DB connection string for this server — stays local only, never on GitHub
/backend/appsettings.json
